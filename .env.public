# Settings of the public web flasher builds (web-flasher/, committed: no
# secrets). WiFi is set up on the board itself (canon-ts207-Setup portal).
#   PRINTSERVER_ENV_FILE=.env.public pio run -e esp32s3    (Lily Touch)
#   PRINTSERVER_ENV_FILE=.env.public pio run -e s3_n16r8   (YD-ESP32-S3 N16R8)
WIFI_SSID=
WIFI_PASSWORD=
PRINTER_NAME=Canon TS207 (ESP32)
HOSTNAME=canon-ts207
# normal: no WiFi firmware updates for anyone on the network (the /firmware
# page still switches the USB port to flash mode)
MODE=normal
